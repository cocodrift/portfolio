<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The M's Hub - Fitness, Fashion, Tech & Lifestyle Trends</title>
  <meta name="description" content="Discover trends in fitness, fashion, tech, and lifestyle at The M's Hub. Join our community for insights!" />
  <meta name="keywords" content="fitness, fashion, technology, lifestyle, personal growth, Kenya" />
  <meta property="og:title" content="The M's Hub - Trends in Fitness, Fashion, Tech & More" />
  <meta property="og:description" content="Join The M's Hub to explore trends in fitness, fashion, technology, and lifestyle in Kenya. Stay inspired!" />
  <meta property="og:image" content="/images/pp.jpg" />
  <meta property="og:url" content="https://ms-hubke.vercel.app/" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/images/pp.jpg" type="image/x-icon" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Merienda:wght@300..900&display=swap" rel="stylesheet" />
  
  <!-- AOS CSS -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="/styles/style.css" />

  
</head>
<body>
  <!-- Skip to Content Link for Accessibility -->
  <a href="#main" class="skip-link">Skip to content</a>

  <header>
    <a href="/" class="site-title">
      <h2>M's Hub Ke</h2>
    </a>
    <button class="menu-toggle" aria-label="Toggle navigation">☰</button>
  </header>

  <nav class="nav">
    <ul>
      <li><a href="/profile">Profile</a></li>
      <li><a href="#explore">Explore</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <main id="main">

    <section id="explore" data-aos="fade-up">
      <h2>Explore</h2>
      <div class="explore-content">
        <div class="explore-categories" data-aos="fade-right">
          <h3>Categories</h3>
          <ul>
            <li><a href="https://www.youtube.com/@mark_Ke">Lifestyle & Vlogs</a></li>
            <li><a href="/travel">Travel & Adventure</a></li>
          </ul>
        </div>
        <div class="explore-tags" data-aos="fade-up">
          <h3>Popular Tags</h3>
          <ul>
            <li><a href="/fitness">Fitness Workouts</a></li>
          </ul>
        </div>
        <div class="explore-authors" data-aos="fade-left">
          <h3>Featured Authors</h3>
          <ul>
            <li>
              <img src="/images/pp.jpg" alt="Mark Mwaniki, Front-end Developer and Fitness Instructor" loading="lazy" />
              <span class="author-name">Mark Mwaniki</span>
              <span class="author-bio">Front-end Developer<br>Electrical Technician<br>Fitness Instructor</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <%- include('partials/footer') %>
  </footer>

  <!-- Scripts -->
  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script src="/scripts/main.js"></script>
  <script>
    AOS.init();
    document.querySelector('.menu-toggle').addEventListener('click', () => {
      document.querySelector('.nav').classList.toggle('open');
    });
  </script>
<script async src="https://www.googletagmanager.com/gtag/js?id=UA-XXXXX-X"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'UA-XXXXX-X');
</script>
</body>
</html>
