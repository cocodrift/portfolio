<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>M's Hub KE — Fitness, Fashion, Tech, Lifestyle & Travel</title>

  <meta
    name="description"
    content="M's Hub KE — practical ideas, stories and guides covering fitness, fashion, technology, lifestyle and travel."
  />

  <meta
    name="keywords"
    content="M's Hub KE, Kenya, fitness, fashion, technology, lifestyle, travel"
  />

  <meta property="og:title" content="M's Hub KE" />
  <meta
    property="og:description"
    content="Ideas, guides and stories for modern life."
  />
  <meta property="og:url" content="https://ms-hubke.vercel.app/" />
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/images/pp.jpg" type="image/x-icon" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/styles/style.css" />
</head>

<body>

  <a href="#main" class="skip-link">Skip to content</a>

  <!-- HEADER -->
  <header class="site-header">

    <div class="header-inner">

      <a href="/" class="brand">
        <span class="brand-mark">M</span>
        <span class="brand-name">M's Hub <strong>KE</strong></span>
      </a>

      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/learn">Articles</a>
        <a href="/learn?category=Fitness">Fitness</a>
        <a href="/learn?category=Fashion">Fashion</a>
        <a href="/learn?category=Tech">Tech</a>
        <a href="/learn?category=Lifestyle">Lifestyle</a>
        <a href="/learn?category=Travel">Travel</a>
        <a href="/profile">About</a>
      </nav>

      <button
        class="mobile-menu-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        ☰
      </button>

    </div>

    <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation">
      <a href="/learn">All Articles</a>
      <a href="/learn?category=Fitness">Fitness</a>
      <a href="/learn?category=Fashion">Fashion</a>
      <a href="/learn?category=Tech">Tech</a>
      <a href="/learn?category=Lifestyle">Lifestyle</a>
      <a href="/learn?category=Travel">Travel</a>
      <a href="/profile">About</a>
    </nav>

  </header>


  <main id="main">

    <!-- HERO -->
    <section class="home-hero">

      <div class="hero-inner">

        <div class="hero-copy">

          <p class="eyebrow">
            M'S HUB KE
          </p>

          <h1>
            Ideas, guides & stories
            <span>for modern life.</span>
          </h1>

          <p class="hero-description">
            Explore practical ideas and interesting stories across fitness,
            fashion, technology, lifestyle and travel — with a Kenyan
            perspective.
          </p>

          <div class="hero-actions">
            <a href="/learn" class="button button-dark">
              Explore articles
            </a>

            <a href="/profile" class="button button-light">
              About M's Hub
            </a>
          </div>

        </div>

        <div class="hero-side">

          <div class="hero-stat">
            <span>05</span>
            <p>Topics</p>
          </div>

          <div class="hero-line"></div>

          <p>
            Fitness<br />
            Fashion<br />
            Tech<br />
            Lifestyle<br />
            Travel
          </p>

        </div>

      </div>

    </section>


    <!-- FEATURED -->
    <% if (featuredPost) { %>

      <section class="featured-section">

        <div class="section-heading">

          <div>
            <p class="section-label">FEATURED</p>
            <h2>Worth reading</h2>
          </div>

          <a href="/learn" class="view-all">
            View all articles →
          </a>

        </div>


        <article class="featured-card">

          <a
            href="/learn/<%= featuredPost.slug %>"
            class="featured-image-link"
          >

            <% if (featuredPost.featuredImage) { %>

              <img
                src="<%= featuredPost.featuredImage %>"
                alt="<%= featuredPost.title %>"
                class="featured-image"
                loading="eager"
              />

            <% } else { %>

              <div class="image-placeholder featured-placeholder">
                <span><%= featuredPost.category %></span>
              </div>

            <% } %>

          </a>


          <div class="featured-content">

            <span class="category-pill">
              <%= featuredPost.category %>
            </span>

            <h3>
              <a href="/learn/<%= featuredPost.slug %>">
                <%= featuredPost.title %>
              </a>
            </h3>

            <% if (featuredPost.excerpt) { %>

              <p>
                <%= featuredPost.excerpt %>
              </p>

            <% } %>

            <div class="article-meta">

              <span>
                <%= featuredPost.author || "M's Hub KE" %>
              </span>

              <% if (featuredPost.publishedAt) { %>

                <span>•</span>

                <time>
                  <%= new Date(featuredPost.publishedAt).toLocaleDateString(
                    'en-KE',
                    {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric'
                    }
                  ) %>
                </time>

              <% } %>

            </div>

            <a
              href="/learn/<%= featuredPost.slug %>"
              class="read-link"
            >
              Read article →
            </a>

          </div>

        </article>

      </section>

    <% } else { %>

      <!-- EMPTY STATE -->
      <section class="empty-home">

        <p class="section-label">M'S HUB KE</p>

        <h2>The first story is waiting.</h2>

        <p>
          Publish your first article from the admin dashboard and it will
          appear here automatically.
        </p>

        <a href="/admin/posts/new" class="button button-dark">
          Create an article
        </a>

      </section>

    <% } %>


    <!-- CATEGORIES -->
    <section class="categories-section">

      <div class="section-heading">

        <div>
          <p class="section-label">EXPLORE</p>
          <h2>Find your thing.</h2>
        </div>

      </div>


      <div class="category-grid">

        <a
          href="/learn?category=Fitness"
          class="category-card category-fitness"
        >
          <span class="category-number">01</span>
          <div>
            <h3>Fitness</h3>
            <p>Training, movement & healthier living.</p>
          </div>
          <span class="category-arrow">↗</span>
        </a>


        <a
          href="/learn?category=Fashion"
          class="category-card category-fashion"
        >
          <span class="category-number">02</span>
          <div>
            <h3>Fashion</h3>
            <p>Style, grooming & personal expression.</p>
          </div>
          <span class="category-arrow">↗</span>
        </a>


        <a
          href="/learn?category=Tech"
          class="category-card category-tech"
        >
          <span class="category-number">03</span>
          <div>
            <h3>Tech</h3>
            <p>Apps, gadgets, AI & digital life.</p>
          </div>
          <span class="category-arrow">↗</span>
        </a>


        <a
          href="/learn?category=Lifestyle"
          class="category-card category-lifestyle"
        >
          <span class="category-number">04</span>
          <div>
            <h3>Lifestyle</h3>
            <p>Ideas for work, money & everyday life.</p>
          </div>
          <span class="category-arrow">↗</span>
        </a>


        <a
          href="/learn?category=Travel"
          class="category-card category-travel"
        >
          <span class="category-number">05</span>
          <div>
            <h3>Travel</h3>
            <p>Places, experiences & adventures.</p>
          </div>
          <span class="category-arrow">↗</span>
        </a>

      </div>

    </section>


    <!-- LATEST ARTICLES -->
    <% if (latestPosts && latestPosts.length > 0) { %>

      <section class="latest-section">

        <div class="section-heading">

          <div>
            <p class="section-label">THE LATEST</p>
            <h2>Fresh from M's Hub</h2>
          </div>

          <a href="/learn" class="view-all">
            All articles →
          </a>

        </div>


        <div class="article-grid">

          <% latestPosts.forEach(post => { %>

            <article class="article-card">

              <a href="/learn/<%= post.slug %>" class="article-image-link">

                <% if (post.featuredImage) { %>

                  <img
                    src="<%= post.featuredImage %>"
                    alt="<%= post.title %>"
                    class="article-image"
                    loading="lazy"
                  />

                <% } else { %>

                  <div class="image-placeholder">
                    <span><%= post.category %></span>
                  </div>

                <% } %>

              </a>


              <div class="article-card-content">

                <span class="article-category">
                  <%= post.category %>
                </span>

                <h3>
                  <a href="/learn/<%= post.slug %>">
                    <%= post.title %>
                  </a>
                </h3>

                <% if (post.excerpt) { %>

                  <p>
                    <%= post.excerpt %>
                  </p>

                <% } %>

                <a
                  href="/learn/<%= post.slug %>"
                  class="read-link"
                >
                  Read more →
                </a>

              </div>

            </article>

          <% }) %>

        </div>

      </section>

    <% } %>


    <!-- IDENTITY SECTION -->
    <section class="identity-section">

      <div class="identity-inner">

        <div class="identity-photo">

          <img
            src="/images/pp.jpg"
            alt="M's Hub KE"
            loading="lazy"
          />

        </div>


        <div class="identity-copy">

          <p class="section-label">WHY M'S HUB?</p>

          <h2>
            Made for life
            <span>in motion.</span>
          </h2>

          <p>
            M's Hub KE brings together the things that make everyday life
            interesting — from getting stronger and dressing better to
            discovering new technology, places and ideas.
          </p>

          <a href="/profile" class="read-link">
            Meet M's Hub →
          </a>

        </div>

      </div>

    </section>


    <!-- CTA -->
    <section class="home-cta">

      <p class="section-label">KEEP EXPLORING</p>

      <h2>
        There is always
        something new.
      </h2>

      <a href="/learn" class="button button-light">
        Browse all articles
      </a>

    </section>

  </main>


  <footer>
    <%- include('partials/footer') %>
  </footer>


  <script>

    const menuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('#mobile-menu');

    if (menuButton && mobileMenu) {

      menuButton.addEventListener('click', () => {

        const open = mobileMenu.classList.toggle('open');

        menuButton.setAttribute(
          'aria-expanded',
          open ? 'true' : 'false'
        );

      });

    }

  </script>

</body>
</html>
