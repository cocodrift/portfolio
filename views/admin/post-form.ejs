<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= post ? 'Edit Article' : 'New Article' %>
    — M's Hub
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f5f5f5;
      font-family: Arial, sans-serif;
    }

    header {
      background: #111;
      color: white;
      padding: 18px 5%;
    }

    header a {
      color: white;
      text-decoration: none;
    }

    main {
      width: min(1000px, 92%);
      margin: 35px auto;
    }

    .editor {
      background: white;
      padding: 30px;
      border-radius: 16px;
    }

    .field {
      margin-bottom: 24px;
    }

    label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font: inherit;
    }

    textarea {
      min-height: 450px;
      line-height: 1.6;
      resize: vertical;
    }

    .small textarea {
      min-height: 100px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .help {
      display: block;
      margin-top: 6px;
      color: #777;
      font-size: 13px;
    }

    .buttons {
      display: flex;
      gap: 12px;
      margin-top: 30px;
    }

    button,
    .cancel {
      border: 0;
      border-radius: 8px;
      padding: 13px 20px;
      cursor: pointer;
      text-decoration: none;
      font-weight: bold;
    }

    .publish {
      background: #111;
      color: white;
    }

    .draft {
      background: #ddd;
      color: #111;
    }

    .cancel {
      background: #eee;
      color: #111;
    }

    .error {
      padding: 14px;
      background: #fee;
      color: #900;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    @media (max-width: 700px) {

      .grid {
        grid-template-columns: 1fr;
      }

      .editor {
        padding: 20px;
      }

    }

  </style>

</head>


<body>

<header>

  <a href="/admin/posts">
    ← Back to articles
  </a>

</header>


<main>

  <div class="editor">

    <h1>
      <%= post ? 'Edit Article' : 'New Article' %>
    </h1>


    <% if (error) { %>

      <div class="error">
        <%= error %>
      </div>

    <% } %>


    <form
      method="POST"
      action="<%= post
        ? '/admin/posts/' + post._id
        : '/admin/posts' %>"
    >


      <div class="field">

        <label for="title">
          Article title
        </label>

        <input
          id="title"
          type="text"
          name="title"
          value="<%= post ? post.title : '' %>"
          placeholder="How to Start Working Out at Home"
          required
        >

      </div>


      <div class="field">

        <label for="slug">
          URL slug
        </label>

        <input
          id="slug"
          type="text"
          name="slug"
          value="<%= post ? post.slug : '' %>"
          placeholder="how-to-start-working-out-at-home"
        >

        <small class="help">
          Leave blank and it will be generated from the title.
        </small>

      </div>


      <div class="grid">

        <div class="field">

          <label for="category">
            Category
          </label>

          <select
            id="category"
            name="category"
            required
          >

            <option value="">
              Select category
            </option>

            <% const categories = [
              'Fitness',
              'Fashion',
              'Tech',
              'Lifestyle',
              'Travel'
            ]; %>


            <% categories.forEach(category => { %>

              <option
                value="<%= category %>"
                <%= post && post.category === category
                  ? 'selected'
                  : '' %>
              >
                <%= category %>
              </option>

            <% }) %>

          </select>

        </div>


        <div class="field">

          <label for="tags">
            Tags
          </label>

          <input
            id="tags"
            type="text"
            name="tags"
            value="<%= post ? post.tags : '' %>"
            placeholder="fitness, workout, beginners"
          >

          <small class="help">
            Separate tags with commas.
          </small>

        </div>

      </div>


      <div class="field small">

        <label for="excerpt">
          Excerpt
        </label>

        <textarea
          id="excerpt"
          name="excerpt"
          placeholder="A short description of the article..."
        ><%= post ? post.excerpt : '' %></textarea>

      </div>


      <div class="field">

        <label for="content">
          Article
        </label>

        <textarea
          id="content"
          name="content"
          placeholder="# Your article title

Start writing here.

## First section

Write your content...

## Second section

More useful information..."
          required
        ><%= post ? post.content : '' %></textarea>

        <small class="help">
          Write using Markdown. Use # for headings,
          **bold**, *italic*, lists and links.
        </small>

      </div>


      <div class="field">

        <label for="featuredImage">
          Featured image URL
        </label>

        <input
          id="featuredImage"
          type="url"
          name="featuredImage"
          value="<%= post ? post.featuredImage : '' %>"
          placeholder="https://..."
        >

      </div>


      <div class="grid">

        <div class="field">

          <label for="seoTitle">
            SEO title
          </label>

          <input
            id="seoTitle"
            type="text"
            name="seoTitle"
            maxlength="160"
            value="<%= post ? post.seoTitle : '' %>"
            placeholder="Best Home Workouts for Beginners"
          >

        </div>


        <div class="field">

          <label for="author">
            Author
          </label>

          <input
            id="author"
            type="text"
            name="author"
            value="<%= post
              ? post.author
              : 'M’s Hub KE' %>"
          >

        </div>

      </div>


      <div class="field small">

        <label for="seoDescription">
          SEO description
        </label>

        <textarea
          id="seoDescription"
          name="seoDescription"
          maxlength="320"
          placeholder="Learn how to start working out at home..."
        ><%= post ? post.seoDescription : '' %></textarea>

      </div>


      <div class="field">

        <label for="status">
          Status
        </label>

        <select
          id="status"
          name="status"
        >

          <option
            value="draft"
            <%= post && post.status === 'draft'
              ? 'selected'
              : '' %>
          >
            Save as draft
          </option>

          <option
            value="published"
            <%= post && post.status === 'published'
              ? 'selected'
              : '' %>
          >
            Publish
          </option>

        </select>

      </div>


      <div class="buttons">

        <button
          type="submit"
          class="publish"
        >
          <%= post ? 'Save changes' : 'Save article' %>
        </button>


        <a
          href="/admin/posts"
          class="cancel"
        >
          Cancel
        </a>

      </div>


    </form>

  </div>

</main>

</body>

</html>
