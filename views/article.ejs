<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= post.seoTitle || post.title %> | M's Hub KE
  </title>


  <meta
    name="description"
    content="<%= post.seoDescription || post.excerpt || post.title %>"
  >


  <link
    rel="canonical"
    href="https://ms-hubke.vercel.app/learn/<%= post.slug %>"
  >


  <meta
    property="og:type"
    content="article"
  >

  <meta
    property="og:title"
    content="<%= post.seoTitle || post.title %>"
  >

  <meta
    property="og:description"
    content="<%= post.seoDescription || post.excerpt || post.title %>"
  >

  <meta
    property="og:url"
    content="https://ms-hubke.vercel.app/learn/<%= post.slug %>"
  >


  <% if (post.featuredImage) { %>

    <meta
      property="og:image"
      content="<%= post.featuredImage %>"
    >

  <% } %>


  <link
    rel="stylesheet"
    href="/styles/learn.css"
  >

  <style>

    .article-video {
      margin: 50px 0;
    }

    .article-video h2 {
      margin-bottom: 20px;
      font-size: 1.7rem;
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 18px;
      background: #111;
      box-shadow:
        0 15px 40px rgba(0, 0, 0, 0.12);
    }

    .video-wrapper iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    @media (max-width: 650px) {

      .article-video {
        margin: 35px 0;
      }

      .video-wrapper {
        border-radius: 12px;
      }

    }

  </style>

</head>


<body>


<header class="hub-header">

  <a
    href="/"
    class="logo"
  >
    M's Hub KE
  </a>


  <nav>

    <a href="/learn">
      Explore
    </a>

    <a href="/fitness">
      Fitness
    </a>

    <a href="/travel">
      Travel
    </a>

    <a href="/profile">
      Profile
    </a>

  </nav>

</header>


<main>

  <article class="article">


    <div class="article-category">
      <%= post.category %>
    </div>


    <h1>
      <%= post.title %>
    </h1>


    <% if (post.excerpt) { %>

      <p class="article-excerpt">
        <%= post.excerpt %>
      </p>

    <% } %>


    <div class="article-meta">

      <span>
        By <%= post.author %>
      </span>


      <% if (post.publishedAt) { %>

        <span>

          <%= new Date(post.publishedAt)
            .toLocaleDateString('en-KE', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            }) %>

        </span>

      <% } %>

    </div>


    <% if (post.featuredImage) { %>

      <img
        class="article-image"
        src="<%= post.featuredImage %>"
        alt="<%= post.title %>"
      >

    <% } %>


    <div class="article-content">

      <%- articleHtml %>

    </div>


    <% if (post.videoUrl) { %>

      <section class="article-video">

        <% if (post.videoTitle) { %>

          <h2>
            <%= post.videoTitle %>
          </h2>

        <% } %>


        <div class="video-wrapper">

          <iframe
            src="<%= post.videoUrl %>"
            title="<%= post.videoTitle || post.title %>"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
          </iframe>

        </div>

      </section>

    <% } %>


    <% if (post.tags && post.tags.length) { %>

      <div class="tags">

        <% post.tags.forEach(tag => { %>

          <span>
            #<%= tag %>
          </span>

        <% }) %>

      </div>

    <% } %>


  </article>


  <% if (relatedPosts.length) { %>

    <section class="related">

      <h2>
        More from <%= post.category %>
      </h2>


      <div class="related-grid">

        <% relatedPosts.forEach(related => { %>

          <a
            href="/learn/<%= related.slug %>"
            class="related-card"
          >

            <% if (related.featuredImage) { %>

              <img
                src="<%= related.featuredImage %>"
                alt="<%= related.title %>"
                loading="lazy"
              >

            <% } %>


            <div>

              <span>
                <%= related.category %>
              </span>

              <h3>
                <%= related.title %>
              </h3>

            </div>

          </a>

        <% }) %>

      </div>

    </section>

  <% } %>


</main>


<footer>

  <p>
    © <%= new Date().getFullYear() %> M's Hub KE
  </p>

</footer>


</body>

</html>
